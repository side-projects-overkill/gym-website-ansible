# Managed by Ansible (playbooks/deploy-app.yml) - do not edit by hand.
#
# The Gym Tracker app (gunicorn on 127.0.0.1:{{ app_port }}) serves every
# URL. Nothing is served from disk, so no internal files can leak publicly.

ServerTokens Prod
ServerSignature Off

ProxyPreserveHost On
ProxyTimeout 180

ProxyPass / http://127.0.0.1:{{ app_port }}/
ProxyPassReverse / http://127.0.0.1:{{ app_port }}/
