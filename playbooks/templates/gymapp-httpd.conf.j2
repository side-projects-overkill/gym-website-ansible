# Managed by Ansible (playbooks/deploy-app.yml) - do not edit by hand.
#
# The Gym Tracker Flask app (gunicorn on 127.0.0.1:{{ app_port }}) serves the
# whole site, including the landing page at /. Only the deployment docs page
# and Apache's status page are served by Apache itself.

ProxyPreserveHost On
ProxyTimeout 180

ProxyPass /server-status !
ProxyPass /readme.html !
ProxyPass / http://127.0.0.1:{{ app_port }}/
ProxyPassReverse / http://127.0.0.1:{{ app_port }}/
