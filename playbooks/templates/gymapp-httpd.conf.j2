# Managed by Ansible (playbooks/deploy-app.yml) - do not edit by hand.
#
# Routing model:
#   - /            -> static site from DocumentRoot (/var/www/html)
#   - app prefixes -> Gym Tracker Flask app (gunicorn on 127.0.0.1:{{ app_port }})
#
# The app lives at the root path internally, so we proxy each of its route
# prefixes explicitly. When adding a new top-level route to the Flask app,
# add its prefix to the list below.

ProxyPreserveHost On
ProxyTimeout 60

ProxyPass /server-status !

{% for prefix in app_route_prefixes %}
ProxyPass /{{ prefix }} http://127.0.0.1:{{ app_port }}/{{ prefix }}
ProxyPassReverse /{{ prefix }} http://127.0.0.1:{{ app_port }}/{{ prefix }}
{% endfor %}
